{
  "name": "@onrampfunds/embed-react",
  "version": "0.0.2",
  "description": "React wrapper for @onrampfunds/embed. Placeholder release \u2014 the component lands in CTO-344.",
  "license": "MIT",
  "author": "Onramp Funds",
  "homepage": "https://github.com/onrampfunds/embed/tree/main/packages/embed-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onrampfunds/embed.git",
    "directory": "packages/embed-react"
  },
  "bugs": {
    "url": "https://github.com/onrampfunds/embed/issues"
  },
  "keywords": [
    "onramp",
    "onramp-funds",
    "react",
    "embedded-finance",
    "prequalification"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@onrampfunds/embed": "0.0.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  }
}
